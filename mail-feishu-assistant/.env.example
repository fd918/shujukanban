# 飞书自建应用凭证。放在本目录 .env 文件里，不要提交真实值。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://tanwenjie-mail-assistant.loca.lt/callback

# OAuth 授权范围。通常不用改，必须与你在飞书后台开通的权限匹配。
FEISHU_SCOPES=offline_access mail:user_mailbox:readonly mail:user_mailbox.folder:read mail:user_mailbox.message:readonly mail:user_mailbox.message.subject:read mail:user_mailbox.message.body:read mail:user_mailbox.message.address:read mail:user_mailbox.message:send

# 邮箱地址。留空时会优先使用授权返回的企业邮箱。
FEISHU_MAILBOX_ID=

# 定时巡检时区。默认每天 08:00 到 22:00，每小时执行一次。
# 每个人也可以在飞书里发送“设置巡检时间 8-12,14-18,20-22”设置自己的时间段。
TIMEZONE=Asia/Shanghai

# 每次最多读取收件箱最近多少封，再过滤今天邮件。
# 飞书接口对单页数量有限制，建议保持 20。
SCAN_PAGE_SIZE=20

# 识别规则，英文逗号分隔。
ACTION_KEYWORDS=请谭总,谭总,审批,请审批,同意,请同意,请处理,请确认,确认,申请,批准,续期
NOISE_KEYWORDS=数据详见附件,每日汇总,数据统计,数据日报,验证码,安全提醒,sign up code

# 飞书通知目标。可留空，启动后给机器人发送“绑定我”自动保存当前聊天。
FEISHU_NOTIFY_RECEIVE_ID=
FEISHU_NOTIFY_RECEIVE_ID_TYPE=chat_id

# 回复安全策略：true=允许按飞书指令直接发邮件；false=只回显拟发送内容。
ALLOW_SEND_EMAIL=true

# 流失看板邮件表格同步。默认在9点后的每10分钟检查一次，邮件当天数据自动排除。
MAIL_CHURN_CRON=5,15,25,35,45,55 9 * * *
MAIL_CHURN_LOCAL_SYNC_URL=http://127.0.0.1:8791/api/mail-churn-sync
MAIL_CHURN_SERVER_SYNC_URL=http://服务器IP:8791/api/mail-churn-sync

# 完整请求头统一保存在这一项，以后只整体替换这一段 JSON；真实令牌不要提交到 Git。
MAIL_CHURN_SERVER_REQUEST_HEADERS={"authorization":"Bearer 请填写随机同步令牌","content-type":"application/json","content-encoding":"gzip"}
